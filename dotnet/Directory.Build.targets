<Project>

  <!-- Signs published exes when a signing identity is configured: a cert in
       CurrentUser\My named by thumbprint. Precedence is /p:WaypointSignThumbprint,
       then WAYPOINT_SIGN_THUMBPRINT, then the machine-local props file that
       setup-dev-signing.ps1 writes. Unset = skip, so a publish still works for
       anyone without a cert. Swapping the self-signed dev cert for a real OV/EV
       cert is a thumbprint change and nothing else. -->

  <PropertyGroup>
    <WaypointSignThumbprint Condition="'$(WaypointSignThumbprint)' == ''">$(WAYPOINT_SIGN_THUMBPRINT)</WaypointSignThumbprint>
    <WaypointTimestampUrl Condition="'$(WaypointTimestampUrl)' == ''">http://timestamp.digicert.com</WaypointTimestampUrl>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <Target Name="WaypointSign" Condition="'$(WaypointSignThumbprint)' != ''">
    <PropertyGroup>
      <_WaypointPublishedExe>$(PublishDir)$(AssemblyName).exe</_WaypointPublishedExe>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)sign.ps1&quot; -Path &quot;$(_WaypointPublishedExe)&quot; -Thumbprint $(WaypointSignThumbprint) -TimestampUrl $(WaypointTimestampUrl)" />
  </Target>

  <!-- AOT replaces the apphost in PublishDir via CopyNativeBinary, which itself
       runs AfterTargets="Publish" — signing on Publish would be overwritten. -->
  <Target Name="WaypointSignAotPublish"
          AfterTargets="CopyNativeBinary"
          DependsOnTargets="WaypointSign"
          Condition="'$(PublishAot)' == 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')" />

  <Target Name="WaypointSignPublish"
          AfterTargets="Publish"
          DependsOnTargets="WaypointSign"
          Condition="'$(PublishAot)' != 'true' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')" />

  <Target Name="WaypointSignSkipped"
          AfterTargets="Publish"
          Condition="('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe') and '$(WaypointSignThumbprint)' == ''">
    <Message Importance="high" Text="Publish not signed: run dotnet/setup-dev-signing.ps1 (or set WAYPOINT_SIGN_THUMBPRINT)." />
  </Target>

</Project>
