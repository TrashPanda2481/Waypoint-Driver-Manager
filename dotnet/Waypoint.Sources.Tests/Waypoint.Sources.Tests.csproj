<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waypoint.Core\Waypoint.Core.csproj" />
    <ProjectReference Include="..\Waypoint.Sources\Waypoint.Sources.csproj" />
  </ItemGroup>

  <!-- Real trimmed vendor catalogs, copied verbatim from tests/fixtures/oem. -->
  <ItemGroup>
    <None Include="fixtures\oem\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures\oem\*.cab" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
