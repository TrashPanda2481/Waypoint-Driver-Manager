<Application x:Class="Waypoint.Gui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Waypoint.Gui"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <local:BoolToVisibilityConverter x:Key="BoolToVisible" />
        <local:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />

        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Panel" Color="#F6F7F9" />
        <SolidColorBrush x:Key="Line" Color="#DFE3E8" />
        <SolidColorBrush x:Key="Muted" Color="#5C6570" />

        <!-- Warning, not the accent: reserved for things the technician must read. -->
        <SolidColorBrush x:Key="Warn" Color="#C9820A" />
        <SolidColorBrush x:Key="WarnFill" Color="#FFF7E6" />
        <SolidColorBrush x:Key="WarnInk" Color="#6B4708" />
        <SolidColorBrush x:Key="FlagFill" Color="#FFE9C7" />
        <SolidColorBrush x:Key="FlagInk" Color="#6B4708" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,0,18,6" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </Application.Resources>
</Application>
